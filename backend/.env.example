# Copiar como .env y completar. Nunca subir el .env al repositorio.
PUERTO=3001

# ---- Dónde se guardan los datos
# sqlite = base propia en un archivo: ÚNICA FUENTE de ATS/TTR (en Docker va en el volumen /app/backend/datos)
# local  = archivo datos/local.json con personas y tareas ficticias (solo para probar sin base)
# graph  = SharePoint ATSHSS con la identidad propia del backend (lo anterior a nov-2026)
ALMACEN=sqlite
SQLITE_ARCHIVO=datos/ats2.sqlite
# LOCAL_ARCHIVO=datos/local.json

# ---- Microsoft Graph (solo ALMACEN=graph). Registro de Entra con permiso de aplicación Sites.Selected + rol "write" sobre ATSHSS.
GRAPH_TENANT_ID=c7aae0e0-9106-4454-a1cd-697e1111c69c
GRAPH_CLIENT_ID=
# Una de las dos: secreto, o certificado (recomendado)
GRAPH_CLIENT_SECRET=
# GRAPH_CERT_CLAVE=certificado/clave-privada.pem
# GRAPH_CERT_HUELLA_SHA256=
SITIO_HOST=vicunacom.sharepoint.com
SITIO_RUTA=/sites/ATSHSS
# SITIO_ID=vicunacom.sharepoint.com,f4584bfc-5480-4c70-9f5e-470a3538d791,7ecd59f0-15d4-47c4-bedb-42e4bf1d5c6c

# ---- Quién es el usuario (lo dice la otra app): dev | jwt | proxy
IDENTIDAD=dev
DEV_USUARIO_EMAIL=demo@vicuna.com
DEV_USUARIO_NOMBRE=Usuario de prueba
DEV_USUARIO_GESTION=SI
# CLAVE_ACCESO=       (IDENTIDAD=dev publicada en internet: clave larga que la página guarda al abrir ?clave=…; sin ella el backend responde 401)
# JWT_SECRETO=        (IDENTIDAD=jwt: secreto compartido con el backend de la otra app, 32+ caracteres)
# JWT_EMISOR=
# JWT_AUDIENCIA=ats2
# PROXY_CLAVE=        (IDENTIDAD=proxy: clave que agrega el backend de la otra app en x-ats-clave)

# ---- Quién puede entrar a la gestión (/gestion): correos separados por coma. También entra quien traiga el rol
# "ats-gestion" en el JWT (claim roles) o "gestion" en x-ats-usuario-rol (proxy).
GESTION_EMAILS=josemaria.diaz@vicuna.com

# ---- Navegador
# Orígenes de la otra app si llama a este backend desde otro dominio (separados por coma)
# CORS_ORIGENES=https://otra-app.vicuna.com
# Servir el frontend compilado en el mismo puerto (ATS 2.0 en / y la gestión en /gestion)
SERVIR_FRONTEND=../frontend/dist
